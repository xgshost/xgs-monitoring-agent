# Managed by XGS Monitoring Agent.
[Unit]
Description=Synchronize XGS SSH autobans through Fail2ban and UFW
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=xgs-monitor-agent
Group=xgs-monitor-agent
SupplementaryGroups=xgs-monitor-agent-fail2ban
StateDirectory=xgs-monitor-agent
StateDirectoryMode=0700
EnvironmentFile=/etc/xgs-monitor-agent.env
ExecStart=/usr/bin/node /opt/xgs-monitoring-agent/dist/firewall-sync.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
