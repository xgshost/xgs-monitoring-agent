[Unit]
Description=XGS Monitoring V2 Agent (in-place V1 migration)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xgs-monitor-agent
Group=xgs-monitor-agent
EnvironmentFile=/etc/xgs-monitor-agent-v2.env
StateDirectory=xgs-monitor-agent-v2
StateDirectoryMode=0700
WorkingDirectory=/opt/xgs-monitor-agent-v2
ExecStart=/usr/bin/node --preserve-symlinks-main /opt/xgs-monitor-agent-v2/current/index.js run
Restart=on-failure
RestartForceExitStatus=SIGUSR1
RestartSec=10
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/xgs-monitor-agent-v2 /opt/xgs-monitor-agent-v2

[Install]
WantedBy=multi-user.target
