[Unit]
Description=XGS Monitoring Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xgs-monitor-agent
Group=xgs-monitor-agent
EnvironmentFile=/etc/xgs-monitor-agent.env
StateDirectory=xgs-monitor-agent
StateDirectoryMode=0700
ExecStart=/usr/bin/node /opt/xgs-monitoring-agent/dist/index.js
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
