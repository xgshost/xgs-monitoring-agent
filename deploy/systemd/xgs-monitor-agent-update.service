[Unit]
Description=Update XGS Monitoring Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=HOME=/var/lib/xgs-monitor-agent-update
StateDirectory=xgs-monitor-agent-update
StateDirectoryMode=0700
WorkingDirectory=/opt/xgs-monitoring-agent
ExecStart=/opt/xgs-monitoring-agent/update.sh
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/xgs-monitoring-agent /run/lock
